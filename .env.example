APP_NAME="Repl Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The monitor's own store. SQLite on purpose: it must not depend on a server
# it is watching, and it holds the pairs' encrypted credentials, so it lives
# beside the APP_KEY. Leave DB_DATABASE unset for database/database.sqlite;
# the container sets it to the data volume.
DB_CONNECTION=sqlite
# DB_DATABASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, not database: nothing in this app queues, and a queued alert with no
# worker is an alert that never gets sent.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# smtp, ses-v2, or log to write the alerts to the log instead of sending them.
# Verify with: php artisan replication:test-mail --to=you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="repl-monitor@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# SES over its SMTP endpoint needs no AWS_* at all — MAIL_HOST=email-smtp.<region>.amazonaws.com
# with SES SMTP credentials. The AWS_* below are for MAIL_MAILER=ses-v2, and
# can stay blank where an instance or task role signs the request.
AWS_SES_CONFIGURATION_SET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Replication monitor
REPL_DEFAULT_LAG_THRESHOLD=60
REPL_RETAIN_CHECKS_DAYS=14

# The health endpoint (GET /api/health) for Icinga and friends. Optional —
# tokens are generated on the Health endpoint page. With neither, the route 404s.
REPL_HEALTH_TOKEN=
REPL_HEALTH_STALE_AFTER_MINUTES=5
