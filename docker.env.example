# cp docker.env.example docker.env — this is the file with the secrets in it.

# Where you reach the UI. Behind a reverse proxy this is the public URL, scheme
# included — the container only ever speaks plain http on 8080, so this is what
# tells the app it is an https site:
#
#   APP_URL=https://repl-monitor.example.com
#
# Get it wrong and password-reset links and \Illuminate\Support\Facades\URL
# point somewhere the browser cannot follow.
APP_URL=http://localhost:8000

# Leave blank and the first run generates one onto the volume and says so in
# the log. Set it here instead if you would rather hold the key yourself.
# Either way: it decrypts the stored database passwords, so back it up.
APP_KEY=

# ---------------------------------------------------------------------------
# Alert mail
# ---------------------------------------------------------------------------
# Email is the only way this thing reaches you, so check it rather than assume
# it:
#
#   docker compose run --rm app php artisan replication:test-mail --to=you@example.com
#
# MAIL_MAILER=log writes the emails to the container log instead of sending
# them, which is a reasonable way to watch it work for a day first — and a bad
# thing to still be set a month later.
MAIL_MAILER=smtp

# Who the alerts come from. Whatever sends them has to be allowed to use this
# address; with SES it has to be a verified identity.
MAIL_FROM_ADDRESS=repl-monitor@example.com
MAIL_FROM_NAME="Repl Monitor"

# --- Traditional SMTP ------------------------------------------------------
# Also the way to use SES without installing anything AWS-specific: point
# MAIL_HOST at email-smtp.<region>.amazonaws.com:587 with a set of SES *SMTP*
# credentials (generated in the SES console — they are not your IAM key).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Amazon SES over the API -----------------------------------------------
# Set MAIL_MAILER=ses-v2 instead of smtp, and the MAIL_HOST block above is
# ignored. Worth it for one reason: on EC2 or ECS you can leave the two keys
# blank and let the instance or task role sign the request, so there is no
# secret in this file at all. Off the role, fill them in.
#
# MAIL_MAILER=ses-v2
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_CONFIGURATION_SET=

# Defaults for a new pair; everything here is per-pair in the UI afterwards.
REPL_DEFAULT_LAG_THRESHOLD=60
REPL_RETAIN_CHECKS_DAYS=14

# A CA bundle for pairs with TLS switched on. Mount it in and point at it.
# REPL_SSL_CA=/var/lib/repl-monitor/ca.pem

# The health endpoint, for Icinga or anything else that watches this container:
# GET /api/health, 200 only when every pair is healthy and was checked recently.
# Optional: tokens are generated on the Health endpoint page, which needs no restart to
# take effect and can be rotated without a gap. Set one here to hold the secret
# in the environment instead — openssl rand -hex 24. With neither, the route 404s.
REPL_HEALTH_TOKEN=

# How long the newest check may go without being replaced before the endpoint
# calls it critical. This is what catches a scheduler that has stopped.
REPL_HEALTH_STALE_AFTER_MINUTES=5
