# cp docker.env.example docker.env — this is the file with the secrets in it.

# Where you reach the UI. Behind a reverse proxy, this is the public URL.
APP_URL=http://localhost:8000

# Leave blank and the first run generates one onto the volume and says so in
# the log. Set it here instead if you would rather hold the key yourself.
# Either way: it decrypts the stored database passwords, so back it up.
APP_KEY=

# Alert mail. MAIL_MAILER=log writes the emails to the container log instead of
# sending them, which is a reasonable way to watch it work for a day first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=repl-monitor@example.com
MAIL_FROM_NAME="Repl Monitor"

# Defaults for a new pair; everything here is per-pair in the UI afterwards.
REPL_DEFAULT_LAG_THRESHOLD=60
REPL_RETAIN_CHECKS_DAYS=14

# A CA bundle for pairs with TLS switched on. Mount it in and point at it.
# REPL_SSL_CA=/var/lib/repl-monitor/ca.pem

# The health endpoint, for Icinga or anything else that watches this container:
# GET /api/health, 200 only when every pair is healthy and was checked recently.
# Optional: tokens are generated on the Health endpoint page, which needs no restart to
# take effect and can be rotated without a gap. Set one here to hold the secret
# in the environment instead — openssl rand -hex 24. With neither, the route 404s.
REPL_HEALTH_TOKEN=

# How long the newest check may go without being replaced before the endpoint
# calls it critical. This is what catches a scheduler that has stopped.
REPL_HEALTH_STALE_AFTER_MINUTES=5
